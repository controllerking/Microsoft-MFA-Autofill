{
  "manifest_version": 3,
  "name": "Microsoft MFA TOTP Autofill",
  "version": "1.0.1",
  "description": "Detects Microsoft sign-in and autofills locally generated TOTP codes, reducing reliance on Authenticator push prompts.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ms-totp-autofill@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.microsoftonline.com/*",
    "*://*.live.com/*",
    "*://login.microsoft.com/*",
    "*://account.microsoft.com/*",
    "*://*.msauth.net/*",
    "*://*.msftauth.net/*",
    "*://*.msauthimages.net/*",
    "*://*.msftauthimages.net/*",
    "*://*.msidentity.com/*",
    "*://*.microsoftonline-p.com/*",
    "*://*.microsoftazuread-sso.com/*"
  ],
  "background": {
    "scripts": ["totp.js", "crypto-vault.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MS TOTP Autofill",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.microsoftonline.com/*",
        "*://*.live.com/*",
        "*://login.microsoft.com/*",
        "*://account.microsoft.com/*",
        "*://*.msauth.net/*",
        "*://*.msftauth.net/*",
        "*://*.msauthimages.net/*",
        "*://*.msftauthimages.net/*",
        "*://*.msidentity.com/*",
        "*://*.microsoftonline-p.com/*",
        "*://*.microsoftazuread-sso.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
